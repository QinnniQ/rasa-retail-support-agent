{
  "name": "retail-support-showcase",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:proxy": "node --test tests/proxy.test.js",
    "test:cloud": "node --test tests/cloud-demo.test.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/*.{ts,js}\" \"functions/**/*.js\" \"*.{ts,json,html}\""
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  }
}
