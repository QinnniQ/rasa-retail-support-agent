FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd -r -u 10001 appuser
COPY mock_backend.py ./
COPY support ./support
RUN mkdir -p /app/data && chown appuser:appuser /app/data
USER appuser
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health',timeout=2)"
CMD ["uvicorn", "mock_backend:app", "--host", "0.0.0.0", "--port", "8001"]
